{
  "name": "ergosense",
  "version": "2.2.3",
  "description": "A cross-platform desktop ergonomics assistant",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "build:win": "tsc && vite build && electron-builder --win",
    "build:linux": "tsc && vite build && electron-builder --linux",
    "build:all": "tsc && vite build && electron-builder --mac --win --linux",
    "postinstall": "electron-builder install-app-deps",
    "preview": "vite preview",
    "lint": "eslint renderer/src electron/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:web": "tsc -p tsconfig.json --noEmit",
    "typecheck:electron": "tsc -p tsconfig.node.json --noEmit",
    "typecheck": "npm run typecheck:web && npm run typecheck:electron"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "keywords": [
    "ergonomics",
    "electron",
    "react",
    "ai",
    "posture"
  ],
  "author": {
    "name": "Sadish Gautam",
    "email": "ergosense@sadish.com.np",
    "url": "https://sadish.com.np"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^22.1.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^5.0.10",
    "vite-plugin-electron": "^0.15.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@sentry/electron": "^7.3.0",
    "better-sqlite3": "^12.4.6",
    "brightness": "^3.0.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.555.0",
    "onnxruntime-node": "^1.16.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.5.0"
  }
}
